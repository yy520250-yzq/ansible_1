平台: {{ ansible_virtualization_type | default('物理机') }} · CPU {{ ansible_processor_cores | default('?') }} 核

## 总评: {{ sev_icon.get(worst,'❓') }} {{ sev_text.get(worst,'未知') }}
{% for k in present -%}
{%   set sv = vars.get('hc_section_' + k + '_severity','ok') -%}
## {{ sev_icon.get(sv,'ℹ️') }} {{ vars.get('hc_section_' + k + '_title', k) }} ({{ sv }})
{{ vars.get('hc_section_' + k + '_body','') }}
{% endfor -%}
